# Copy to .env and replace every <...> value. Never commit secrets.

# 1. Runtime and public URLs
PORT=4000
HOST=0.0.0.0
BASE_URL=http://localhost:4000
NODE_ENV=development
PRODUCT_NAME=PULSE
PRODUCT_CATEGORY=Financial Assistant
PRODUCT_LOGO_URL=

# 2. Network visibility and feature gates
ENABLED_NETWORKS=xlayer,base,arbitrum,arc-testnet
DEFAULT_NETWORK=xlayer
FEATURE_POLYMARKET=1
FEATURE_WALLET_APPKIT=1
VITE_FEATURE_WALLET_APPKIT=1
FEATURE_BASE_PAYMENTS=1
FEATURE_ARBITRUM_PAYMENTS=1
FEATURE_ARC_PAYMENTS=1
FEATURE_JOBS=1
FEATURE_LIVE_SAFETY=1
FEATURE_PREDICTION_ANALYSIS=1
FEATURE_FUSED_ANALYSIS=0
FEATURE_DIVERGENCE_ANALYSIS=0
FEATURE_EVENT_RISK_ANALYSIS=0

# 3. Browser build (public values only)
VITE_API_URL=http://localhost:4000
VITE_REOWN_PROJECT_ID=<REOWN_PROJECT_ID>
# Circle User-Controlled Wallets email login. API key is server-only; App ID is public.
CIRCLE_API_KEY=<CIRCLE_USER_CONTROLLED_WALLETS_API_KEY>
VITE_CIRCLE_APP_ID=<CIRCLE_W3S_APP_ID>
VITE_ENABLED_NETWORKS=xlayer,base,arbitrum,arc-testnet
VITE_PAY_TO_ADDRESS=<PAY_TO_ADDRESS>
VITE_CIRCLE_GATEWAY_SELLER_ADDRESS=<CIRCLE_GATEWAY_SELLER_ADDRESS>
VITE_USE_PROXY=0

# 4. Existing X Layer / OKX compatibility
X402_NETWORK=eip155:196
X402_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736
PAY_TO_ADDRESS=<SELLER_EVM_ADDRESS>
# 0 = real wallet settlement (required for manual E2E); 1 = automated-test fixtures only.
X402_MOCK=0
X_LAYER_CHAIN_ID=196
X_LAYER_CAIP2=eip155:196
X_LAYER_RPC=https://rpc.xlayer.tech
X_LAYER_RPC_FALLBACK=https://xlayerrpc.okx.com
X_LAYER_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer
X_LAYER_PAYMENT_PROVIDER=okx
OKX_XLAYER_API_KEY=<OKX_API_KEY>
OKX_XLAYER_API_SECRET=<OKX_API_SECRET>
OKX_XLAYER_API_PASSPHRASE=<OKX_PASSPHRASE>
OKX_BASE_URL=https://web3.okx.com
OKX_FACILITATOR_URL=https://web3.okx.com

# 5. Base mainnet / CDP
BASE_CHAIN_ID=8453
BASE_CAIP2=eip155:8453
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_FALLBACK_URL=
BASE_EXPLORER_URL=https://basescan.org
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_PAYMENT_PROVIDER=cdp

# 6. Arbitrum One / CDP
ARBITRUM_CHAIN_ID=42161
ARBITRUM_CAIP2=eip155:42161
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_FALLBACK_URL=
ARBITRUM_EXPLORER_URL=https://arbiscan.io
ARBITRUM_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
ARBITRUM_PAYMENT_PROVIDER=cdp
ARBITRUM_CIRCLE_GATEWAY_ENABLED=0
ARBITRUM_MPP_ENABLED=0
CDP_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=<CDP_API_KEY_ID>
CDP_API_KEY_SECRET=<CDP_API_KEY_SECRET>
BAZAAR_DISCOVERABLE=1

# 7. Arc Testnet / Circle Gateway
ARC_CHAIN_ID=5042002
ARC_CAIP2=eip155:5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_PAYMENT_PROVIDER=circle-gateway
# live = real xAI reports; fixture = deterministic plumbing test with no market inference.
ARC_AI_MODE=live
ARC_GROK_MODEL=grok-4.3
ARC_LIVE_WALLET_HOURLY_LIMIT=10
ARC_LIVE_IP_HOURLY_LIMIT=20
ARC_LIVE_WALLET_DAILY_LIMIT=25
ARC_LIVE_DAILY_COST_LIMIT_USD=5
CIRCLE_GATEWAY_ENABLED=1
CIRCLE_GATEWAY_TESTNET_URL=https://gateway-api-testnet.circle.com
CIRCLE_GATEWAY_MAINNET_URL=
CIRCLE_GATEWAY_ACCEPTED_NETWORKS=eip155:5042002
CIRCLE_GATEWAY_SELLER_ADDRESS=<SELLER_EVM_ADDRESS>

# 8. Polymarket public data
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_MAX_SELECTED=8
POLYMARKET_STANDARD_MAX_SELECTED=3
POLYMARKET_PREMIUM_MAX_SELECTED=6

# 9. xAI and report budgets
XAI_API_KEY=<XAI_API_KEY>
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.3
# Current provider prices used for cost accounting. Recheck before production.
XAI_INPUT_COST_PER_MILLION_USD=1.25
XAI_CACHED_INPUT_COST_PER_MILLION_USD=0.20
XAI_OUTPUT_COST_PER_MILLION_USD=2.50
GROK_REASONING_STANDARD=none
GROK_REASONING_PREMIUM=low
GROK_MAX_INPUT_STANDARD=12000
GROK_MAX_INPUT_FUSED_STANDARD=13000
GROK_MAX_INPUT_PREMIUM=24000
GROK_MAX_OUTPUT_STANDARD=700
GROK_MAX_OUTPUT_PREMIUM=1200

# 10. Current web-application prices in USD
PRICE_ANALYSIS_BASE=0.10
PRICE_ANALYSIS_PREMIUM=0.20
PRICE_TOKEN_SCAN=0.10
PRICE_PREFLIGHT=0.20

# 10a. Additive V5 service prices
PRICE_ANALYSIS_PREDICTION_STANDARD=0.10
PRICE_ANALYSIS_PREDICTION_PREMIUM=0.20
PRICE_ANALYSIS_FUSED_STANDARD=0.15
PRICE_ANALYSIS_FUSED_PREMIUM=0.30
PRICE_ANALYSIS_DIVERGENCE=0.10
PRICE_PREFLIGHT_EVENT_RISK=0.20

# 11. Durable jobs: Upstash KV + Vercel Blob
STORAGE_PROVIDER=vercel_blob
BLOB_ACCESS=private
REPORT_ENCRYPTION_KEY=
BLOB_READ_WRITE_TOKEN=<BLOB_READ_WRITE_TOKEN>
QUEUE_PROVIDER=upstash_kv
PERSISTENCE_NAMESPACE=pulse:local
KV_REST_API_READ_ONLY_TOKEN=<KV_READ_ONLY_TOKEN>
KV_REST_API_TOKEN=<KV_WRITE_TOKEN>
KV_REST_API_URL=<KV_REST_URL>
KV_URL=<KV_REDIS_URL>
REDIS_URL=<KV_REDIS_URL>
DATABASE_URL=
JOB_WORKER_CONCURRENCY=2
REPORT_RETENTION_DAYS=90
JOB_STAGE_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_DAYS=180
REPORT_DEFAULT_VISIBILITY=private
REPORT_SHARE_LINK_ENABLED=1
PAID_REGENERATION_MAX_ATTEMPTS=2

# 12. Development/operator-only checkout; never enable publicly
TEST_WALLET_ADDRESS=
TEST_WALLET_PRIVATE_KEY=
ENABLE_SERVER_PAY=0
RUN_LIVE_PAY=0
