# Copy to .env and replace every <...> value. Never commit secrets.

# 1. Runtime and public URLs
PORT=4000
HOST=0.0.0.0
BASE_URL=http://localhost:4000
NODE_ENV=development
PRODUCT_NAME=PULSE
PRODUCT_CATEGORY=Trading
PRODUCT_LOGO_URL=

# 2. Network visibility and feature gates
ENABLED_NETWORKS=xlayer,base,arbitrum,arc,robinhood
DEFAULT_NETWORK=xlayer
FEATURE_POLYMARKET=1
FEATURE_WALLET_APPKIT=1
VITE_FEATURE_WALLET_APPKIT=1
FEATURE_BASE_PAYMENTS=1
FEATURE_ARBITRUM_PAYMENTS=1
FEATURE_ARC_PAYMENTS=1
FEATURE_JOBS=1
FEATURE_LIVE_SAFETY=1
FEATURE_PREDICTION_ANALYSIS=1
FEATURE_FUSED_ANALYSIS=0
FEATURE_DIVERGENCE_ANALYSIS=0
FEATURE_EVENT_RISK_ANALYSIS=0
FEATURE_TRADING=1
FEATURE_AUTOPILOT=1
FEATURE_TELEGRAM=1
AUTOPILOT_KILL_SWITCH=0
# Starts the receipt/oracle/trigger/execution reconciliation loop. Keep 0 until roles, routers and a funded restricted signer are configured.
AUTOMATION_WORKER_ENABLED=0
# Dedicated restricted executor approved in the on-chain Registry. Local acceptance may leave this blank and use TEST_WALLET_PRIVATE_KEY as a fallback.
AUTOMATION_EXECUTOR_PRIVATE_KEY=
# Required by the deployment scheduler. Generate a long random server-only value; Vercel Cron sends it as a Bearer token.
CRON_SECRET=
AUTOMATION_INTERVAL_MS=30000
AUTOPILOT_ANALYSIS_INTERVAL_MS=900000
# Independent live TP/SL and latched-exit checks; does not call xAI.
AUTOPILOT_RISK_INTERVAL_MS=60000

# 3. Browser build (public values only)
VITE_API_URL=http://localhost:4000
# Public/app split: keep 0 until app.ai-pulse.tech is configured and verified manually.
# /landing remains available for local preview regardless of this flag.
VITE_PUBLIC_LANDING_ENABLED=0
VITE_APP_ORIGIN=https://app.ai-pulse.tech
VITE_REOWN_PROJECT_ID=<REOWN_PROJECT_ID>
# Circle User-Controlled Wallets email login. API key is server-only; App ID is public.
CIRCLE_API_KEY=<CIRCLE_USER_CONTROLLED_WALLETS_API_KEY>
VITE_CIRCLE_APP_ID=<CIRCLE_W3S_APP_ID>
VITE_ENABLED_NETWORKS=xlayer,base,arbitrum,arc,robinhood
VITE_PAY_TO_ADDRESS=<PAY_TO_ADDRESS>
VITE_CIRCLE_GATEWAY_SELLER_ADDRESS=<CIRCLE_GATEWAY_SELLER_ADDRESS>
VITE_USE_PROXY=0

# 4. Existing X Layer / OKX compatibility
X402_NETWORK=eip155:196
X402_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736
PAY_TO_ADDRESS=<SELLER_EVM_ADDRESS>
# 0 = real wallet settlement (required for manual E2E); 1 = automated-test fixtures only.
X402_MOCK=0
X_LAYER_CHAIN_ID=196
X_LAYER_CAIP2=eip155:196
X_LAYER_RPC=https://rpc.xlayer.tech
X_LAYER_RPC_FALLBACK=https://xlayerrpc.okx.com
X_LAYER_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer
X_LAYER_PAYMENT_PROVIDER=okx
OKX_XLAYER_API_KEY=<OKX_API_KEY>
OKX_XLAYER_API_SECRET=<OKX_API_SECRET>
OKX_XLAYER_API_PASSPHRASE=<OKX_PASSPHRASE>
OKX_BASE_URL=https://web3.okx.com
OKX_FACILITATOR_URL=https://web3.okx.com
# Optional for paid Risk Guard enrichment on Base and Arbitrum; server-side only.
BLOCKSCOUT_API_KEY=

# 5. Base mainnet / CDP
BASE_CHAIN_ID=8453
BASE_CAIP2=eip155:8453
BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_FALLBACK_URL=https://base-rpc.publicnode.com
BASE_EXPLORER_URL=https://basescan.org
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_PAYMENT_PROVIDER=cdp

# 6. Arbitrum One / CDP
ARBITRUM_CHAIN_ID=42161
ARBITRUM_CAIP2=eip155:42161
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_FALLBACK_URL=https://arbitrum-one-rpc.publicnode.com
ARBITRUM_EXPLORER_URL=https://arbiscan.io
ARBITRUM_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
ARBITRUM_PAYMENT_PROVIDER=cdp
ARBITRUM_CIRCLE_GATEWAY_ENABLED=0
ARBITRUM_MPP_ENABLED=0
CDP_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=<CDP_API_KEY_ID>
CDP_API_KEY_SECRET=<CDP_API_KEY_SECRET>
BAZAAR_DISCOVERABLE=1

# 7. Arc Mainnet / Circle Gateway
ARC_CHAIN_ID=5042
ARC_CAIP2=eip155:5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_FALLBACK_URL=https://rpc.quicknode.mainnet.arc.io
ARC_EXPLORER_URL=https://explorer.arc.io
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_PAYMENT_PROVIDER=circle-gateway
# live = real xAI reports; fixture = deterministic plumbing test with no market inference.
ARC_AI_MODE=live
ARC_GROK_MODEL=grok-4.3
ARC_LIVE_WALLET_HOURLY_LIMIT=10
ARC_LIVE_IP_HOURLY_LIMIT=20
ARC_LIVE_WALLET_DAILY_LIMIT=25
ARC_LIVE_DAILY_COST_LIMIT_USD=5
CIRCLE_GATEWAY_ENABLED=1
CIRCLE_GATEWAY_MAINNET_URL=https://gateway-api.circle.com
CIRCLE_GATEWAY_ACCEPTED_NETWORKS=eip155:5042
CIRCLE_GATEWAY_SELLER_ADDRESS=<SELLER_EVM_ADDRESS>

# 8. Polymarket public data
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_MAX_SELECTED=8
POLYMARKET_STANDARD_MAX_SELECTED=3
POLYMARKET_PREMIUM_MAX_SELECTED=6

# 9. xAI and report budgets
XAI_API_KEY=<XAI_API_KEY>
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.3
XAI_INPUT_COST_PER_MILLION_USD=1.25
XAI_CACHED_INPUT_COST_PER_MILLION_USD=0.20
XAI_OUTPUT_COST_PER_MILLION_USD=2.50
GROK_REASONING_STANDARD=none
GROK_REASONING_PREMIUM=low
GROK_MAX_INPUT_STANDARD=12000
GROK_MAX_INPUT_FUSED_STANDARD=13000
GROK_MAX_INPUT_PREMIUM=24000
GROK_MAX_OUTPUT_STANDARD=1800
GROK_MAX_OUTPUT_PREMIUM=3200
GROK_AUTOPILOT_MODEL=grok-4.3
GROK_MAX_INPUT_AUTOPILOT=4000
GROK_MAX_OUTPUT_AUTOPILOT=320
# Compact AI is requested only after deterministic entry gates. Identical pair/timeframe signals are shared.
AUTOPILOT_AI_MIN_INTERVAL_MS=14400000
AUTOPILOT_AI_SIGNAL_TTL_MS=14400000
AUTOPILOT_AI_MAX_CALLS_PER_VAULT_DAY=3
AUTOPILOT_AI_MAX_CALLS_GLOBAL_DAY=50
AUTOPILOT_AI_MAX_USD_PER_VAULT_DAY=0.15
AUTOPILOT_AI_MAX_USD_GLOBAL_DAY=2.00
GROK_MAX_INPUT_PREDICTION_STANDARD=16000
GROK_MAX_INPUT_PREDICTION_PREMIUM=32000
GROK_MAX_OUTPUT_PREDICTION_STANDARD=1400
GROK_MAX_OUTPUT_PREDICTION_PREMIUM=3200

# 10. Public marketplace catalog prices in USD
# Global Quick/Pro and Risk Guard. The Prediction Quick/Pro rows are in 10a.
PRICE_ANALYSIS_BASE=0.20
PRICE_ANALYSIS_PREMIUM=0.30
PRICE_PREFLIGHT=0.20

# 10a. Public Prediction Market catalog prices
PRICE_ANALYSIS_PREDICTION_STANDARD=0.20
PRICE_ANALYSIS_PREDICTION_PREMIUM=0.30

# 10b. Public Autopilot start services on X Layer, Base and Arbitrum
# These are excluded from the Arc Mainnet/Circle subset because Arc has no Autopilot execution.
PRICE_AUTOPILOT_PASS_24H=1.50
PRICE_AUTOPILOT_PASS_7D=10.50
PRICE_AUTOPILOT_PASS_30D=45.00

# 10c. Legacy API/SDK compatibility prices (not advertised in discovery)
PRICE_TOKEN_SCAN=0.20
PRICE_WALLET_SCAN=0.11
PRICE_MARKET_PULSE=0.11
PRICE_SWAP_QUOTE=0.12

# 10d. Disabled experimental compatibility routes (not public products)
# Their FEATURE_* flags above remain 0 in the supported deployment profile.
PRICE_ANALYSIS_FUSED_STANDARD=0.25
PRICE_ANALYSIS_FUSED_PREMIUM=0.40
PRICE_ANALYSIS_DIVERGENCE=0.20
PRICE_PREFLIGHT_EVENT_RISK=0.30

# 11. Durable jobs: Railway Redis + existing Vercel Blob
# See docs/RAILWAY_REDIS_MIGRATION.md. Migrate existing data before cutover.
STORAGE_PROVIDER=vercel_blob
BLOB_ACCESS=public
# PULSE's public Blob transport stores only AES-256-GCM ciphertext.
REPORT_ENCRYPTION_KEY=<BASE64URL_32_BYTE_REPORT_ENCRYPTION_KEY>
BLOB_READ_WRITE_TOKEN=<BLOB_READ_WRITE_TOKEN>
QUEUE_PROVIDER=redis
# Railway service Variables: REDIS_URL=${{Redis.REDIS_URL}}
# Local .env needs a resolved URL reachable from this PC, not a Railway reference.
REDIS_URL=<RAILWAY_REDIS_CONNECTION_URL>
# Optional local readiness/migration tests (--public), never browser-exposed.
REDIS_PUBLIC_URL=
PERSISTENCE_NAMESPACE=pulse:local
# Legacy Upstash source only; ignored by runtime when QUEUE_PROVIDER=redis.
KV_REST_API_READ_ONLY_TOKEN=<KV_READ_ONLY_TOKEN>
KV_REST_API_TOKEN=<KV_WRITE_TOKEN>
KV_REST_API_URL=<KV_REST_URL>
# Reads have bounded retries; ambiguous writes are never automatically replayed.
KV_REQUEST_TIMEOUT_MS=6000
KV_REQUEST_RETRIES=1
KV_CIRCUIT_COOLDOWN_MS=15000
KV_URL=<KV_REDIS_URL>
DATABASE_URL=
JOB_WORKER_CONCURRENCY=2
REPORT_RETENTION_DAYS=90
JOB_STAGE_RETENTION_DAYS=90
IDEMPOTENCY_RETENTION_DAYS=180
REPORT_DEFAULT_VISIBILITY=private
REPORT_SHARE_LINK_ENABLED=1
PAID_REGENERATION_MAX_ATTEMPTS=2

# 12. Development/operator-only checkout; never enable publicly
TEST_WALLET_ADDRESS=
TEST_WALLET_PRIVATE_KEY=
ENABLE_SERVER_PAY=0
RUN_LIVE_PAY=0

# 13. PULSE contracts (public deployed addresses; leave empty to disable that contract feature)
# PulseRegistryV1: adapter/keeper/executor allowlists and emergency automation pause.
XLAYER_PULSE_REGISTRY_ADDRESS=0x814469ebed3a8466266a9fa9cdf78c381c16a146
BASE_PULSE_REGISTRY_ADDRESS=0xa1fef7c527c0e039cb4724bd3a86ccfe49d4c169
ARBITRUM_PULSE_REGISTRY_ADDRESS=0xe54dc99228463dad2c4f2762c9e1baf2d6f2ee07
# OracleRouterV1: verified trigger price policies for protected Spot and Autopilot.
XLAYER_ORACLE_ROUTER_ADDRESS=0x3df7a41d0b07ffcd25ecba43e9b4620c627ba8b0
BASE_ORACLE_ROUTER_ADDRESS=0x1448df2bda5f9bd4a53c8e3fdb123d15e4e6e33d
ARBITRUM_ORACLE_ROUTER_ADDRESS=0xc2cf8dd0ba67142c539053c51fc1da9cc52e1af3
# OkxSwapAdapterV1: validates allowlisted routers, exact assets, minimum output and returns proceeds to the calling Spot account/vault.
# Verified OkxSwapAdapterV2 deployments. Router and approval spender are independently allowlisted.
XLAYER_EXECUTION_ADAPTER_ADDRESS=0x36080c7ef9b793dea9d821e8ee8447226ccf329a
BASE_EXECUTION_ADAPTER_ADDRESS=0x7bd683fee53b3370cde105288180c5b66fb53c8f
ARBITRUM_EXECUTION_ADAPTER_ADDRESS=0x24eb07fdde101420dd9bf994674eee6043c99057
# SpotOrderAccountFactoryV1: owner-controlled dual-trigger TP/SL/OCO protection.
XLAYER_SPOT_ORDER_FACTORY_ADDRESS=0x68faa8b82f9d305a193ba3640de9526479b66c54
BASE_SPOT_ORDER_FACTORY_ADDRESS=0x70c8fe8080e43e9e11e61cbaf1ce17b2754183b3
ARBITRUM_SPOT_ORDER_FACTORY_ADDRESS=0x951ac8cb1524a7856b2940966ab9751c2259af63
# SpotOrderAccountFactoryV2: separate owner-controlled above/below buy/sell limit orders with minimum output and batch close.
XLAYER_SPOT_LIMIT_FACTORY_ADDRESS=0x3f53ed46e18152ac6903e49450e7b227b5236098
BASE_SPOT_LIMIT_FACTORY_ADDRESS=0x6d63ac4e6845298d7a79c69f63531695cdc5aaa7
ARBITRUM_SPOT_LIMIT_FACTORY_ADDRESS=0x8f34357586bbb2c74d46b68ac71e8238bb3d7f63
# SpotBracketAccountFactoryV1: OTOCO limit entry -> optional automatic owner-editable TP/SL. Leave a chain empty to fail closed until its verified deployment exists.
XLAYER_SPOT_BRACKET_FACTORY_ADDRESS=0x073784ac4aaadf755a887880280519535c584bfb
BASE_SPOT_BRACKET_FACTORY_ADDRESS=0x9fb833745c28d0a91a0afb58e6ae64dc0637b4c1
ARBITRUM_SPOT_BRACKET_FACTORY_ADDRESS=0x80196239a939c4664cd1a12de3194c92685a929a
# AutopilotVaultFactoryV2: creates isolated owner vaults with asset allowlists, oracle-valued caps, loss/slippage limits and proof-bound execution.
XLAYER_AUTOPILOT_VAULT_FACTORY_ADDRESS=0xd0fc9d162adde054479d7550a1b9a38f4a2ddc96
BASE_AUTOPILOT_VAULT_FACTORY_ADDRESS=0x8eb18bdce830a7ec6e342c50d9f693f6d7b03cc2
ARBITRUM_AUTOPILOT_VAULT_FACTORY_ADDRESS=0x45ba7d5282d0df187803f7f64ce9d7b8dbb4e8ed


# Robinhood Chain MAINNET (4663): deployed and Sourcify source-verified.
# Manifest: packages/contracts/deployments/4663.json. Automation remains paused.
# These addresses alone do not enable payments, funding swaps or trading.
# Local mainnet payment/recovery tests passed; enable only after production signer/readiness checks.
FEATURE_ROBINHOOD_PAYMENTS=0
FEATURE_ROBINHOOD_TRADING=0
ROBINHOOD_FACILITATOR=self-hosted
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Server-only, dedicated ETH gas wallet. Never use a VITE_ variable or commit a key.
ROBINHOOD_FACILITATOR_PRIVATE_KEY=
# Maximum estimated execution gas charge per settlement, denominated in ETH.
ROBINHOOD_FACILITATOR_MAX_GAS_ETH=0.00001
ROBINHOOD_PULSE_REGISTRY_ADDRESS=0x8cf94c9fabb4a740cf50ebd438b4896101d665a5
ROBINHOOD_ORACLE_ROUTER_ADDRESS=0xa61bea98e42a943874dc80d958b157173b9f5a6e
ROBINHOOD_EXECUTION_ADAPTER_ADDRESS=0x3189d82c8abeb35e8ca80d079781fc5096eca289
ROBINHOOD_OKX_ROUTER_ADDRESS=0x6e2a35a7ad683cf634d91492d73bb7ff774c6919
ROBINHOOD_OKX_APPROVAL_ADDRESS=0x42170295F1173c9e5874ea9d00c6d137E1a4f53d
# SpotOrderAccountFactoryV2 is the LIMIT factory, not the legacy V1 order factory.
ROBINHOOD_SPOT_LIMIT_FACTORY_ADDRESS=0xe54dc99228463dad2c4f2762c9e1baf2d6f2ee07
ROBINHOOD_SPOT_ORDER_FACTORY_ADDRESS=0x1e1f08e79f866df4819cf691c43b6efd9dec513c
ROBINHOOD_SPOT_BRACKET_FACTORY_ADDRESS=0xa4546529b1174765d4d8e256c951365359c853fa
ROBINHOOD_AUTOPILOT_VAULT_FACTORY_ADDRESS=0xc2cf8dd0ba67142c539053c51fc1da9cc52e1af3

# Server operator roles. For isolated testing these may equal TEST_WALLET_ADDRESS;
# use separate least-privilege signers before accepting public capital.
TRADING_KEEPER_ADDRESS=
AUTOPILOT_EXECUTOR_ADDRESS=
# Current OKX Onchain OS router allowlisted by each deployed adapter.
XLAYER_OKX_ROUTER_ADDRESS=0x7c5bee2a8091c3ef39072f64f18fac913060aeaf
BASE_OKX_ROUTER_ADDRESS=0x67d03631fe51b741c0c00c4e16eb662ac84381df
ARBITRUM_OKX_ROUTER_ADDRESS=0x09f94b5fc68e227c323a6fbae3bd98c97fd8c849
