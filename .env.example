PORT=4000
HOST=0.0.0.0
BASE_URL=http://localhost:4000
NODE_ENV=development

X402_NETWORK=eip155:196
X402_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# 1 = mock signatures (local); 0 = official OKX facilitator
X402_MOCK=1

# OKX Payment SDK credentials (Developer Portal)
# Prefer OKX_XLAYER_* or standard OKX_API_* names
OKX_XLAYER_API_KEY=
OKX_XLAYER_API_SECRET=
OKX_XLAYER_API_PASSPHRASE=
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
OKX_BASE_URL=https://web3.okx.com

# xAI Grok (https://console.x.ai — NOT X/Twitter OAuth)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.3

PRODUCT_NAME=PULSE
PRICE_ANALYSIS_BASE=0.03
PRICE_ANALYSIS_PREMIUM=0.06

X_LAYER_RPC=https://rpc.xlayer.tech
X_LAYER_RPC_FALLBACK=https://xlayerrpc.okx.com

PRICE_TOKEN_SCAN=0.01
PRICE_WALLET_SCAN=0.01
PRICE_MARKET_PULSE=0.01
PRICE_SWAP_QUOTE=0.02
PRICE_PREFLIGHT=0.05

PRODUCT_CATEGORY=Financial Assistant
# PRODUCT_LOGO_URL=https://your-cdn/logo.png

# DEV / CI only — automated x402 e2e scripts (scripts/e2e-paid.mjs).
# NEVER use product users' funds here. Web users connect their own wallet in the UI.
TEST_WALLET_ADDRESS=
TEST_WALLET_PRIVATE_KEY=
# Optional: server-side pay for automated demos only (not for production users)
ENABLE_SERVER_PAY=0
# Explicit opt-in for scripts/asp-compliance.mjs to spend from the test wallet.
RUN_LIVE_PAY=0

# Leave empty for local auto-detection (:4000) and same-origin production.
VITE_API_URL=
