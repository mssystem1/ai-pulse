XLAYER_OKX_APPROVAL_ADDRESS=0x8b773D83bc66Be128c60e07E17C8901f7a64F000
BASE_OKX_APPROVAL_ADDRESS=0x57df6092665eb6058DE53939612413ff4B09114E
ARBITRUM_OKX_APPROVAL_ADDRESS=0x70cBb871E8f30Fc8Ce23609E9E0Ea87B6b222F58

# 14. Telegram bot (server-only except the public Mini App URL)
TELEGRAM_BOT_TOKEN=
# Public BotFather username without @. Used only to render the user-facing "Open bot" link.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Public canonical HTTPS web origin. In production it must not redirect to another origin.
TELEGRAM_MINI_APP_URL=
# Telegram-native research checkout. Choose integer Stars prices; blank prices disable that service.
TELEGRAM_STARS_ENABLED=0
TELEGRAM_WEBHOOK_BASE_URL=https://pulse-api-production-7aae.up.railway.app
TELEGRAM_STARS_GLOBAL_QUICK=10
TELEGRAM_STARS_RISK_GUARD=15
TELEGRAM_STARS_PREDICTION_QUICK=10
TELEGRAM_STARS_GLOBAL_PRO=15
TELEGRAM_STARS_PREDICTION_PRO=15

TELEGRAM_TON_MINI_APP_ENABLED=1
TELEGRAM_TON_MINI_APP_URL=https://www.ai-pulse.tech/ton-miniapp
TELEGRAM_SUPPORT_CONTACT=
VITE_TELEGRAM_TON_APP_RETURN_URL=https://t.me/pulsemi_bot?startapp

