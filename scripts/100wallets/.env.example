# Shared wallet registry
# generate-100-wallets-env.mjs writes PULSE_WALLETS_JSON into .env.wallets.
WALLET_COUNT=100
WALLET_ENV_FILE=.env.wallets

# Monad native MON → Relay exact-output → X Layer USDT0
CONFIRM_LIVE_BRIDGE=NO
MONAD_RPC_URL=
MONAD_TREASURY_PRIVATE_KEY=

X_LAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_USDT0_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736
TARGET_USDT0_PER_WALLET=0.11

# Both caps are expressed in MON.
MAX_SOURCE_PER_WALLET=
MAX_TOTAL_SOURCE_SPEND=
MIN_MON_GAS_RESERVE=0.01

# Optional Relay settings
# RELAY_API_KEY=
RELAY_STATUS_TIMEOUT_MS=300000
RELAY_STATUS_POLLING_MS=1500
DESTINATION_VERIFY_TIMEOUT_MS=120000
REQUEST_DELAY_MS=1000
# BRIDGE_LOG_FILE=relay-monad-xlayer-funding.json

# PULSE paid usage — unchanged x402 logic
CONFIRM_LIVE_PAY=NO
PULSE_ENDPOINT=https://pulse-api-production-8d1f.up.railway.app/v1/token/scan
TOKEN_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736
TOKEN_CHAIN_ID=196
X_LAYER_RPC=https://rpc.xlayer.tech
X402_NETWORK=eip155:196
X402_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736
EXPECTED_AMOUNT_ATOMIC=10000
# EXPECTED_PAY_TO=0x...
MAX_ATTEMPTS_PER_WALLET=20
RETRY_DELAY_MS=1500
RUN_LOG=pulse-100-wallets-results.json
